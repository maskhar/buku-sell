# Vite embeds these public values during image build; never put secrets here.
# Copy to .env for docker compose, then rebuild image after changing values.
VITE_CHECKOUT_SINGLE=
VITE_CHECKOUT_FOUR=
VITE_CHECKOUT_SIX=
VITE_CHECKOUT_BALIK=
VITE_CHECKOUT_WMETHOD=
VITE_CHECKOUT_DOSEEN=
VITE_CHECKOUT_MIRING=
VITE_CHECKOUT_CITY=
VITE_CHECKOUT_MONETIZED=

# Optional ISO 8601 deadline, e.g. 2026-12-31T23:59:59+07:00
VITE_PROMO_DEADLINE=
# Optional JSON arrays; empty means no testimonials or order notifications.
VITE_TESTIMONIALS=
VITE_ORDERS=

# Clearly labeled preview data only. Leave empty in production.
VITE_SOCIAL_PROOF_MODE=

# SEO and Google services. Public identifiers, not secrets.
VITE_GOOGLE_SITE_VERIFICATION=
# Choose one tracking method. Prefer GTM for multiple marketing tags.
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
